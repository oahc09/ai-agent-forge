{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-forge:event:1",
  "title": "ForgeEvent v1 (M1 task registry)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "correlationId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "causationId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "schemaVersion": {
      "const": 1
    },
    "aggregateVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "eventType": {
      "enum": [
        "task.discovered",
        "task.triaged",
        "auth.requested",
        "auth.granted",
        "auth.denied",
        "task.queued",
        "task.claimed",
        "task.started",
        "task.heartbeat",
        "task.awaiting_approval",
        "task.resumed",
        "task.validation_started",
        "task.validation_completed",
        "task.review_completed",
        "task.pr_prepared",
        "task.finished",
        "task.failed",
        "task.retried",
        "task.cancelled",
        "task.quarantined",
        "task.evidence_recorded",
        "task.lease_recovered",
        "budget.exhausted",
        "policy.violation"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "eventId",
    "aggregateId",
    "idempotencyKey",
    "correlationId",
    "actor",
    "schemaVersion",
    "aggregateVersion",
    "eventType",
    "occurredAt",
    "payload"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "task.discovered"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "task": {
                "$ref": "urn:agent-forge:task:1"
              }
            },
            "required": [
              "task"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "task.triaged"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": []
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "eventType": {
            "const": "auth.requested"
          }
        }
      },
