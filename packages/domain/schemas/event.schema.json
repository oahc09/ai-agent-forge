        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reportId": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "passed": {
                "type": "boolean"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": [
              "reportId",
              "passed"
            ]
          }
        }
      }
    },
    {
