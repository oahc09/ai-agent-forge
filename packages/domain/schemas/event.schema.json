      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "reason": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "errorCode": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "required": []
