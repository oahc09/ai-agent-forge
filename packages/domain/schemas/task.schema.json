{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-forge:task:1",
  "title": "ForgeTask v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "repo",
    "budgetId",
    "permissions",
    "dependencies",
    "allowedPaths",
    "acceptanceIds",
    "source",
    "status",
    "risk",
    "attempt",
    "maxAttempts",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "repo": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "budgetId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "allowedPaths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "acceptanceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "issue",
            "ci",
            "schedule",
            "manual"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "status": {
      "enum": [
        "DISCOVERED",
        "TRIAGED",
        "AWAITING_AUTH",
        "QUEUED",
        "CLAIMED",
        "RUNNING",
        "WAITING_APPROVAL",
        "VALIDATING",
        "REVIEWING",
        "PR_READY",
        "DONE",
        "FAILED",
        "CANCELLED",
        "QUARANTINED"
      ]
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "attempt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "maxAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "leaseUntil": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d\\.\\d{3}Z$"
    }
  },
  "$comment": "Runtime also enforces attempt <= maxAttempts and prohibits self dependencies."
}
