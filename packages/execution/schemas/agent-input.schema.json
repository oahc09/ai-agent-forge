{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-forge.invalid/schemas/agent-input.schema.json",
  "$ref": "#/$defs/input",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "path": {
      "type": "string",
      "pattern": "^/(?:[A-Za-z0-9_@.+-]+/)*[A-Za-z0-9_@.+-]+$",
      "maxLength": 4096
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "branch",
        "taskId",
        "sourceVersion"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "taskId": {
          "$ref": "#/$defs/id"
        },
        "sourceVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "uri",
        "sha256",
        "readOnly"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "readOnly": {
          "const": true
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "classification",
        "evidenceRefs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "classification": {
          "enum": [
            "verified",
            "inferred"
          ]
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "maxItems": 256
        }
      }
    },
    "capsule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "scope",
        "goal",
        "facts",
        "references",
        "changedCommits",
        "failedExperiments",
        "openQuestions",
        "nextSteps",
        "confidentiality",
        "createdAt",
        "expiresAt",
        "acceptedBy"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "$ref": "#/$defs/id"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          },
          "maxItems": 256
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "maxItems": 256
        },
        "changedCommits": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$"
          },
          "maxItems": 256
        },
        "failedExperiments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 256
        },
        "openQuestions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 256
        },
        "nextSteps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "maxItems": 256
        },
        "confidentiality": {
          "enum": [
            "public",
            "internal"
          ]
        },
        "createdAt": {
          "$ref": "#/$defs/time"
        },
        "expiresAt": {
          "$ref": "#/$defs/time"
        },
        "acceptedBy": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyDecisionId",
        "commands",
        "networkDomains",
        "readPaths",
        "writePaths"
      ],
      "properties": {
        "policyDecisionId": {
          "$ref": "#/$defs/id"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "executable",
              "args"
            ],
            "properties": {
              "executable": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096
                },
                "maxItems": 256
              }
            }
          },
          "maxItems": 256
        },
        "networkDomains": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$"
          },
          "maxItems": 256
        },
        "readPaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "maxItems": 256
        },
        "writePaths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "maxItems": 256
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "maxTokens",
        "maxCalls",
        "maxCostMicros",
        "timeoutMs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "maxTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxCostMicros": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "taskId",
        "runId",
        "purpose",
        "scope",
        "readOnlyRefs",
        "permissions",
        "budget",
        "cwd",
        "capsule",
        "trace",
        "approvalRef",
        "attempt"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "taskId": {
          "$ref": "#/$defs/id"
        },
        "runId": {
          "$ref": "#/$defs/id"
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "readOnlyRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "maxItems": 256
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        },
        "budget": {
          "$ref": "#/$defs/budget"
        },
        "cwd": {
          "$ref": "#/$defs/path"
        },
        "capsule": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/capsule"
            }
          ]
        },
        "trace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "traceId",
            "spanId"
          ],
          "properties": {
            "traceId": {
              "$ref": "#/$defs/id"
            },
            "spanId": {
              "$ref": "#/$defs/id"
            }
          }
        },
        "approvalRef": {
          "type": "string",
          "pattern": "^approval:[A-Za-z0-9._-]{1,100}$"
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "taskId",
        "runId",
        "adapterId",
        "scope",
        "createdAt",
        "expiresAt",
        "capsule",
        "lastSequence",
        "recovery"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "taskId": {
          "$ref": "#/$defs/id"
        },
        "runId": {
          "$ref": "#/$defs/id"
        },
        "adapterId": {
          "$ref": "#/$defs/id"
        },
        "scope": {
          "$ref": "#/$defs/scope"
        },
        "createdAt": {
          "$ref": "#/$defs/time"
        },
        "expiresAt": {
          "$ref": "#/$defs/time"
        },
        "capsule": {
          "$ref": "#/$defs/capsule"
        },
        "lastSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "recovery": {
          "const": "new-session-with-summary"
        }
      }
    },
    "event": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "taskId",
            "runId",
            "sequence",
            "occurredAt",
            "type",
            "status"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "taskId": {
              "$ref": "#/$defs/id"
            },
            "runId": {
              "$ref": "#/$defs/id"
            },
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "occurredAt": {
              "$ref": "#/$defs/time"
            },
            "type": {
              "const": "status"
            },
            "status": {
              "enum": [
                "running",
                "succeeded",
                "cancelled"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "taskId",
            "runId",
            "sequence",
            "occurredAt",
            "type",
            "text"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "taskId": {
              "$ref": "#/$defs/id"
            },
            "runId": {
              "$ref": "#/$defs/id"
            },
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "occurredAt": {
              "$ref": "#/$defs/time"
            },
            "type": {
              "const": "output"
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaVersion",
            "taskId",
            "runId",
            "sequence",
            "occurredAt",
            "type",
            "status",
            "code",
            "retryable"
          ],
          "properties": {
            "schemaVersion": {
              "const": 1
            },
            "taskId": {
              "$ref": "#/$defs/id"
            },
            "runId": {
              "$ref": "#/$defs/id"
            },
            "sequence": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "occurredAt": {
              "$ref": "#/$defs/time"
            },
            "type": {
              "const": "failure"
            },
            "status": {
              "const": "failed"
            },
            "code": {
              "enum": [
                "TIMEOUT",
                "ADAPTER_FAILURE",
                "CONTEXT_MISSING"
              ]
            },
            "retryable": {
              "type": "boolean"
            }
          }
        }
      ]
    }
  }
}
